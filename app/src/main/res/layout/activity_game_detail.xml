<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050505"
    tools:context=".GameDetailActivity">

    <!-- TOP ACTION BAR -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_alignParentTop="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <!-- BOTÃO VOLTAR -->
        <FrameLayout
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_close_circle"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/back"
                app:tint="#FFFFFF"
                android:contentDescription="Voltar" />
        </FrameLayout>

        <!-- TABS CENTRAIS -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal">

            <!-- TAB DETALHES (ATIVO) -->
            <LinearLayout
                android:id="@+id/tabDetalhes"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingHorizontal="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Detalhes"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp"
                    android:fontFamily="sans-serif-bold"
                    android:textStyle="bold" />

                <!-- INDICADOR LARANJA DA TAB DETALHES -->
                <View
                    android:layout_width="28dp"
                    android:layout_height="3.5dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_post_icon" />
            </LinearLayout>

            <!-- TAB AVALIAÇÕES (INATIVO) -->
            <LinearLayout
                android:id="@+id/tabAvaliacoes"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginStart="16dp"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingHorizontal="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Avaliações"
                    android:textColor="#9E9E9E"
                    android:textSize="17sp"
                    android:fontFamily="sans-serif-medium" />

                <View
                    android:layout_width="28dp"
                    android:layout_height="3.5dp"
                    android:layout_marginTop="4dp"
                    android:visibility="invisible" />
            </LinearLayout>

        </LinearLayout>

        <!-- AÇÕES À DIREITA (COMPARTILHAR E FAVORITO) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/btnShare"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_close_circle"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_share_24"
                    app:tint="#FFFFFF"
                    android:contentDescription="Compartilhar" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/btnFavorite"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_close_circle"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_star"
                    app:tint="#FF9800"
                    android:contentDescription="Favorito" />
            </FrameLayout>

        </LinearLayout>

    </LinearLayout>

    <!-- CONTENT SCROLLVIEW -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/bottomBar"
        android:layout_below="@+id/topBar"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="24dp">

            <!-- 1. HERO GAME BANNER -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="210dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView
                        android:id="@+id/imgBanner"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/gta5" />

                    <!-- OVERLAY DEGRADÊ INFERIOR -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="80dp"
                        android:layout_alignParentBottom="true"
                        android:background="@drawable/banner_overlay" />

                    <!-- WATERMARK LOGO "GOD OF WAR" NO CANTO INFERIOR DIREITO -->
                    <TextView
                        android:id="@+id/txtGameWatermark"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_alignParentBottom="true"
                        android:layout_marginEnd="14dp"
                        android:layout_marginBottom="12dp"
                        android:text="GOD OF WAR"
                        android:textColor="#E0E0E0"
                        android:textSize="18sp"
                        android:fontFamily="sans-serif-black"
                        android:textStyle="bold"
                        android:letterSpacing="0.05"
                        android:shadowColor="#CC000000"
                        android:shadowDx="2"
                        android:shadowDy="2"
                        android:shadowRadius="4" />

                    <!-- INDICADOR CENTRADO DE PÁGINAS DO CAROUSEL BANNER -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerHorizontal="true"
                        android:layout_alignParentBottom="true"
                        android:layout_marginBottom="12dp"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <!-- INDICADOR ATIVO -->
                        <View
                            android:layout_width="24dp"
                            android:layout_height="6dp"
                            android:background="@drawable/bg_post_icon" />

                        <!-- INDICADOR INATIVO -->
                        <View
                            android:layout_width="6dp"
                            android:layout_height="6dp"
                            android:layout_marginStart="4dp"
                            android:background="#66FFFFFF" />
                    </LinearLayout>

                </RelativeLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 2. GAME POSTER & METADATA -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <!-- COVER THUMBNAIL (POSTER) -->
                <LinearLayout
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <FrameLayout
                        android:layout_width="100dp"
                        android:layout_height="135dp">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/imgPoster"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:src="@drawable/gta5"
                            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.SmallComponent" />

                        <!-- BADGE VIP DO POSTER -->
                        <TextView
                            android:id="@+id/badgeVip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="top|start"
                            android:layout_margin="6dp"
                            android:background="@drawable/bg_post_icon"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="3dp"
                            android:text="VIP"
                            android:textColor="#FFFFFF"
                            android:textSize="10sp"
                            android:fontFamily="sans-serif-black"
                            android:textStyle="bold" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/btnVerDetalhes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:text="Ver detalhes >"
                        android:textColor="#A1A1A6"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif-medium" />

                </LinearLayout>

                <!-- TITULO E INFORMAÇÕES ADICIONAIS -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <!-- TITULO -->
                    <TextView
                        android:id="@+id/txtTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="God of War 4"
                        android:textColor="#FFFFFF"
                        android:textSize="22sp"
                        android:fontFamily="sans-serif-black"
                        android:textStyle="bold" />

                    <!-- LINHA DE CONTROLE -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Controle:"
                            android:textColor="#9E9E9E"
                            android:textSize="13sp"
                            android:fontFamily="sans-serif" />

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginStart="8dp"
                            android:src="@drawable/ic_gamepad"
                            app:tint="#FF9800"
                            android:contentDescription="Controle Gamepad" />

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginStart="8dp"
                            android:src="@drawable/ic_android_keyboard"
                            app:tint="#FF9800"
                            android:contentDescription="Teclado" />
                    </LinearLayout>

                    <!-- CHIPS HORIZONTAIS DE GÊNEROS E TAGS -->
                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:clipToPadding="false"
                        android:overScrollMode="never"
                        android:scrollbars="none">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <!-- TAG LINK EUA -->
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="6dp"
                                android:background="@drawable/bg_flag_link"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="4dp"
                                android:text="🇺🇸 NA Link"
                                android:textColor="#FF9800"
                                android:textSize="11sp"
                                android:fontFamily="sans-serif-bold"
                                android:textStyle="bold" />

                            <!-- TAG AVENTURA -->
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="6dp"
                                android:background="@drawable/bg_pill_outline"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="4dp"
                                android:text="Aventura"
                                android:textColor="#E3E3E3"
                                android:textSize="11sp" />

                            <!-- TAG 3D -->
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="6dp"
                                android:background="@drawable/bg_pill_outline"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="4dp"
                                android:text="3D"
                                android:textColor="#E3E3E3"
                                android:textSize="11sp" />

                            <!-- TAG FANTASIA -->
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="6dp"
                                android:background="@drawable/bg_pill_outline"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="4dp"
                                android:text="Fantasia"
                                android:textColor="#E3E3E3"
                                android:textSize="11sp" />

                            <!-- TAG VIOLÊNCIA -->
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="6dp"
                                android:background="@drawable/bg_pill_outline"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="4dp"
                                android:text="Violência"
                                android:textColor="#E3E3E3"
                                android:textSize="11sp" />

                            <!-- TAG ATMOSFÉRICO -->
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_pill_outline"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="4dp"
                                android:text="Atm..."
                                android:textColor="#E3E3E3"
                                android:textSize="11sp" />

                        </LinearLayout>
                    </HorizontalScrollView>

                </LinearLayout>

            </LinearLayout>

            <!-- 3. QUADRO DE AVISOS -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Quadro de Avisos"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:fontFamily="sans-serif-bold"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_notice_board"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">

                <FrameLayout
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_post_icon">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="POST"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:fontFamily="sans-serif-black"
                        android:textStyle="bold" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Modificação do idioma :"
                        android:textColor="#E2E8F0"
                        android:textSize="13sp"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="「SETTINGS」 - 「Language」 - 「Text Langua..."
                        android:textColor="#94A3B8"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- 4. ANÚNCIO (CLARO FLEX) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_ad_banner"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp"
                android:paddingVertical="10dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Anúncios"
                        android:textColor="#757575"
                        android:textSize="10sp"
                        android:fontFamily="sans-serif-medium" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:src="@drawable/bg_post_icon"
                            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.SmallComponent" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:text="Claro flex"
                            android:textColor="#000000"
                            android:textSize="16sp"
                            android:fontFamily="sans-serif-bold"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- BOTÃO DE DOWNLOAD AD -->
                <FrameLayout
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_post_icon"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_download_24"
                        app:tint="#FFFFFF"
                        android:contentDescription="Download" />
                </FrameLayout>

            </LinearLayout>

            <!-- 5. TODAS AS AVALIAÇÕES -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp">

                <TextView
                    android:id="@+id/txtAvaliacoesHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:fontFamily="sans-serif-bold"
                    android:text="Todas as Avaliações >"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/btnEscreverAvaliacao"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/bg_orange_outline_pill"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="7dp"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:src="@drawable/ic_edit"
                        app:tint="#FF9800"
                        android:contentDescription="Avaliar" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="Avaliações"
                        android:textColor="#FF9800"
                        android:textSize="13sp"
                        android:fontFamily="sans-serif-bold"
                        android:textStyle="bold" />
                </LinearLayout>
            </RelativeLayout>

            <!-- CARD DE AVALIAÇÃO DE EXEMPLO -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card_black"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- AVATAR PERSONAGEM -->
                    <FrameLayout
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_avatar_circle">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_gravity="center"
                            android:src="@drawable/avatar"
                            android:contentDescription="Avatar Usuario" />
                    </FrameLayout>

                    <!-- NOME, ESTRELAS E TEMPO -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Daniel Amorim"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp"
                            android:fontFamily="sans-serif-bold"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <!-- ESTRELAS -->
                            <ImageView
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:src="@drawable/ic_star"
                                app:tint="#FFD54F" />

                            <ImageView
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:layout_marginStart="2dp"
                                android:src="@drawable/ic_star"
                                app:tint="#FFD54F" />

                            <ImageView
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:layout_marginStart="2dp"
                                android:src="@drawable/ic_star"
                                app:tint="#FFD54F" />

                            <ImageView
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:layout_marginStart="2dp"
                                android:src="@drawable/ic_star"
                                app:tint="#FFD54F" />

                            <ImageView
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:layout_marginStart="2dp"
                                android:src="@drawable/ic_star"
                                app:tint="#FFD54F" />

                            <!-- ÍCONE RELÓGIO + TEMPO DE JOGO -->
                            <ImageView
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                android:layout_marginStart="10dp"
                                android:src="@drawable/ic_vip_clock"
                                app:tint="#9E9E9E"
                                android:contentDescription="Tempo de Jogo" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:text="6h 53min"
                                android:textColor="#9E9E9E"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- OPÇÕES (TRÊS PONTOS) -->
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_more_horiz_24"
                        app:tint="#A1A1A6"
                        android:contentDescription="Opções" />

                </LinearLayout>

                <!-- TEXTO DA AVALIAÇÃO -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="joao mv bom"
                    android:textColor="#E3E3E3"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif" />

            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- FLOATING BOTTOM ACTION BAR -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_alignParentBottom="true"
        android:background="@drawable/bg_bottom_bar_gradient"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp">

        <!-- BOTÃO SECUNDÁRIO (LAYERS/STACK) -->
        <FrameLayout
            android:id="@+id/btnLayers"
            android:layout_width="90dp"
            android:layout_height="54dp"
            android:background="@drawable/icon_out_game"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_layers_24"
                app:tint="#FFFFFF"
                android:contentDescription="Menu Opções" />
        </FrameLayout>

        <!-- BOTÃO PRINCIPAL (JOGAR) -->
        <LinearLayout
            android:id="@+id/btnPlay"
            android:layout_width="0dp"
            android:layout_height="54dp"

            android:layout_weight="1"
