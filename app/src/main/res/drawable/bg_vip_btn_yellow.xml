<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#E6C200"
                android:endColor="#D67D00"
                android:type="linear" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#FFDF5C"
                android:endColor="#FF9500"
                android:type="linear" />
            <corners android:radius="28dp" />
            <stroke
                android:width="1.5dp"
                android:color="#FFF3B0" />
        </shape>
    </item>
</selector>
