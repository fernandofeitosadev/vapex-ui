<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Parte 3D (Sombra de profundidade) -->
    <item android:top="4dp">
        <shape android:shape="rectangle">
            <solid android:color="#35520D" />
            <corners android:radius="8dp" />
        </shape>
    </item>

    <!-- Parte Frontal (Botão) -->
    <item android:bottom="4dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#75b022"
                android:endColor="#588a17"
                android:angle="90" />
            <corners android:radius="8dp" />
            <stroke android:width="1dp" android:color="#a3cf06" />
        </shape>
    </item>
</layer-list>